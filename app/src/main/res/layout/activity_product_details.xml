<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Loading -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Product Image -->
        <ImageView
            android:id="@+id/ivProductImage"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:layout_marginBottom="12dp"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- Product Name / Brand / Category -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:id="@+id/tvProductName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loading..."
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#212121"/>
                <TextView android:id="@+id/tvBrand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#616161"
                    android:layout_marginTop="4dp"/>
                <TextView android:id="@+id/tvCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#9E9E9E"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- BANNED BANNER -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBanned"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="#FFEBEE"
            app:cardCornerRadius="12dp">
            <TextView android:id="@+id/tvBannedReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:textColor="#B71C1C"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Safety Rating -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SAFETY RATING"
                    android:textSize="11sp"
                    android:textColor="#9E9E9E"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1"/>
                <TextView android:id="@+id/tvSafetyRating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="--/10"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>
                <TextView android:id="@+id/tvSafetyDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"/>
                <!-- Ingredient Verdict -->
                <TextView android:id="@+id/tvSafetyVerdict"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ══ AI SAFETY ANALYSIS CARD (NEW) ══════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAiAnalysis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#EDE7F6">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView android:id="@+id/tvAiAnalysisTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🤖  AI Safety Analysis"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#4527A0"/>
                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progressAiScore"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:visibility="gone"
                        app:indicatorSize="24dp"/>
                </LinearLayout>

                <TextView android:id="@+id/tvAiAnalysis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Analyzing..."
                    android:textSize="13sp"
                    android:textColor="#311B92"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Nutrition Facts -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nutrition (per 100g)"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:layout_marginBottom="8dp"/>

                <!-- Calories -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Calories" android:textColor="#616161" android:textSize="13sp"/>
                    <TextView android:id="@+id/tvCalories" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="--"
                        android:textStyle="bold" android:textColor="#212121" android:textSize="13sp"/>
                </LinearLayout>
                <!-- Protein -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="2dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Protein" android:textColor="#616161" android:textSize="13sp"/>
                    <TextView android:id="@+id/tvProtein" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="--"
                        android:textStyle="bold" android:textColor="#212121" android:textSize="13sp"/>
                </LinearLayout>
                <TextView android:id="@+id/tvProteinLevel" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textSize="11sp"
                    android:textColor="#9E9E9E" android:layout_marginBottom="6dp"/>
                <!-- Carbs -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="2dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Carbohydrates" android:textColor="#616161" android:textSize="13sp"/>
                    <TextView android:id="@+id/tvCarbs" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="--"
                        android:textStyle="bold" android:textColor="#212121" android:textSize="13sp"/>
                </LinearLayout>
                <TextView android:id="@+id/tvCarbLevel" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textSize="11sp"
                    android:textColor="#9E9E9E" android:layout_marginBottom="6dp"/>
                <!-- Sugar -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="2dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="  └ Sugar" android:textColor="#616161" android:textSize="13sp"/>
                    <TextView android:id="@+id/tvSugar" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="--"
                        android:textStyle="bold" android:textColor="#212121" android:textSize="13sp"/>
                </LinearLayout>
                <TextView android:id="@+id/tvSugarLevel" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textSize="11sp"
                    android:textColor="#9E9E9E" android:layout_marginBottom="6dp"/>
                <!-- Fat -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="4dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Total Fat" android:textColor="#616161" android:textSize="13sp"/>
                    <TextView android:id="@+id/tvFat" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="--"
                        android:textStyle="bold" android:textColor="#212121" android:textSize="13sp"/>
                </LinearLayout>
                <!-- Sat Fat -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="  └ Saturated Fat" android:textColor="#616161" android:textSize="13sp"/>
                    <TextView android:id="@+id/tvSatFat" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="--"
                        android:textStyle="bold" android:textColor="#212121" android:textSize="13sp"/>
                </LinearLayout>
                <!-- Fiber -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Dietary Fiber" android:textColor="#616161" android:textSize="13sp"/>
                    <TextView android:id="@+id/tvFiber" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="--"
                        android:textStyle="bold" android:textColor="#212121" android:textSize="13sp"/>
                </LinearLayout>
                <!-- Sodium -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="2dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Sodium" android:textColor="#616161" android:textSize="13sp"/>
                    <TextView android:id="@+id/tvSodium" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="--"
                        android:textStyle="bold" android:textColor="#212121" android:textSize="13sp"/>
                </LinearLayout>
                <TextView android:id="@+id/tvSodiumLevel" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#9E9E9E"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Raw Ingredients -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ingredients List"
                    android:textSize="14sp" android:textStyle="bold"
                    android:textColor="#212121" android:layout_marginBottom="8dp"/>
                <TextView android:id="@+id/tvIngredientsRaw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loading..."
                    android:textSize="12sp" android:textColor="#616161"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Flagged Ingredients -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardIngredientWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:id="@+id/tvIngredientWarningTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp" android:textStyle="bold"
                    android:textColor="#E65100" android:layout_marginBottom="8dp"/>
                <LinearLayout android:id="@+id/llIngredientFlags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Safe Ingredients -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardIngredientSafe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:id="@+id/tvIngredientSafeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp" android:textStyle="bold"
                    android:textColor="#2E7D32" android:layout_marginBottom="8dp"/>
                <LinearLayout android:id="@+id/llSafeIngredients"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAskAI"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="🤖  Ask AI About This Product"
            android:textSize="14sp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddToDiet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="➕  Add to Today's Diet"
            android:textSize="14sp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

    </LinearLayout>
</ScrollView>