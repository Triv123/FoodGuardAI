<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- Loading -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="visible"/>

    <!-- Error layout -->
    <LinearLayout
        android:id="@+id/layoutError"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="❌"
            android:textSize="48sp"/>

        <TextView
            android:id="@+id/tvError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Product not found"
            android:textSize="16sp"
            android:textColor="#757575"
            android:gravity="center"
            android:layout_marginTop="16dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Try Again"
            android:layout_marginTop="24dp"
            android:backgroundTint="#2E7D32"/>
    </LinearLayout>

    <!-- Main content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/layoutContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:paddingBottom="100dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Product image - full width hero -->
            <ImageView
                android:id="@+id/imgProduct"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:scaleType="centerCrop"
                android:background="#E8F5E9"/>

            <!-- Banned chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chipBannedStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="16dp"
                android:text="⚠️ BANNED"
                android:textColor="#FFFFFF"
                app:chipBackgroundColor="#C62828"
                android:visibility="gone"/>

            <!-- Content padding -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Product name & brand card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvProductName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Product Name"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#1B5E20"/>

                        <TextView
                            android:id="@+id/tvBrand"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Brand"
                            android:textSize="15sp"
                            android:textColor="#424242"
                            android:layout_marginTop="4dp"/>

                        <TextView
                            android:id="@+id/tvCategory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Category"
                            android:textSize="13sp"
                            android:textColor="#9E9E9E"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Safety rating card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardSafetyRating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🛡️ SAFETY RATING"
                                    android:textSize="12sp"
                                    android:textColor="#757575"
                                    android:textAllCaps="true"
                                    android:letterSpacing="0.1"/>

                                <TextView
                                    android:id="@+id/tvSafetyDescription"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Calculating..."
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="#212121"
                                    android:layout_marginTop="2dp"/>
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvSafetyRating"
                                android:layout_width="72dp"
                                android:layout_height="72dp"
                                android:gravity="center"
                                android:text="0/10"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:background="@drawable/circle_rating_bg"/>
                        </LinearLayout>

                        <!-- Rating bar track -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="10dp"
                            android:background="#E0E0E0"
                            android:layout_marginTop="12dp">

                            <View
                                android:id="@+id/safetyRatingBar"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:background="#4CAF50"/>
                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Nutrition card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📊 Nutrition per 100g"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#212121"
                            android:layout_marginBottom="12dp"/>

                        <!-- Calories - highlighted -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="#FFF8E1"
                            android:padding="10dp"
                            android:layout_marginBottom="12dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="🔥 Calories"
                                android:textSize="15sp" android:textStyle="bold"
                                android:textColor="#E65100"/>
                            <TextView android:id="@+id/tvCalories"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="— kcal" android:textSize="15sp"
                                android:textStyle="bold" android:textColor="#E65100"/>
                        </LinearLayout>

                        <!-- Protein row -->
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="2dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="💪 Protein"
                                android:textSize="14sp" android:textColor="#424242"/>
                            <TextView android:id="@+id/tvProtein"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="— g" android:textSize="14sp"
                                android:textStyle="bold" android:textColor="#212121"/>
                        </LinearLayout>
                        <TextView android:id="@+id/tvProteinLevel"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="" android:textSize="11sp" android:textColor="#4CAF50"
                            android:layout_marginBottom="8dp" android:layout_marginStart="4dp"/>

                        <!-- Divider -->
                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:background="#F0F0F0" android:layout_marginBottom="8dp"/>

                        <!-- Carbs row -->
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="2dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="🌾 Carbohydrates"
                                android:textSize="14sp" android:textColor="#424242"/>
                            <TextView android:id="@+id/tvCarbs"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="— g" android:textSize="14sp"
                                android:textStyle="bold" android:textColor="#212121"/>
                        </LinearLayout>
                        <TextView android:id="@+id/tvCarbLevel"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="" android:textSize="11sp" android:textColor="#FF9800"
                            android:layout_marginBottom="8dp" android:layout_marginStart="4dp"/>

                        <!-- Sugar row -->
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="2dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="🍬 Sugar"
                                android:textSize="14sp" android:textColor="#424242"/>
                            <TextView android:id="@+id/tvSugar"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="— g" android:textSize="14sp"
                                android:textStyle="bold" android:textColor="#212121"/>
                        </LinearLayout>
                        <TextView android:id="@+id/tvSugarLevel"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="" android:textSize="11sp" android:textColor="#F44336"
                            android:layout_marginBottom="8dp" android:layout_marginStart="4dp"/>

                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:background="#F0F0F0" android:layout_marginBottom="8dp"/>

                        <!-- Fat row -->
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="4dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="🧈 Total Fat"
                                android:textSize="14sp" android:textColor="#424242"/>
                            <TextView android:id="@+id/tvFat"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="— g" android:textSize="14sp"
                                android:textStyle="bold" android:textColor="#212121"/>
                        </LinearLayout>

                        <!-- Saturated fat -->
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="   ↳ Saturated Fat"
                                android:textSize="13sp" android:textColor="#757575"/>
                            <TextView android:id="@+id/tvSaturatedFat"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="— g" android:textSize="13sp" android:textColor="#757575"/>
                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:background="#F0F0F0" android:layout_marginBottom="8dp"/>

                        <!-- Fiber row -->
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="🌿 Fiber"
                                android:textSize="14sp" android:textColor="#424242"/>
                            <TextView android:id="@+id/tvFiber"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="— g" android:textSize="14sp"
                                android:textStyle="bold" android:textColor="#212121"/>
                        </LinearLayout>

                        <!-- Sodium row -->
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="2dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="🧂 Sodium"
                                android:textSize="14sp" android:textColor="#424242"/>
                            <TextView android:id="@+id/tvSodium"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="— mg" android:textSize="14sp"
                                android:textStyle="bold" android:textColor="#212121"/>
                        </LinearLayout>
                        <TextView android:id="@+id/tvSodiumLevel"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="" android:textSize="11sp" android:textColor="#4CAF50"
                            android:layout_marginStart="4dp"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Ask AI button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAskAI"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:text="🤖  Ask AI About This Product"
                    android:textSize="15sp"
                    android:backgroundTint="#1565C0"/>

                <!-- spacer -->
                <View android:layout_width="match_parent"
                    android:layout_height="8dp"/>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Add to Diet button - always visible at bottom -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddToDiet"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:text="➕  Add to My Diet"
        android:textSize="17sp"
        android:textStyle="bold"
        android:backgroundTint="#2E7D32"
        app:elevation="8dp"
        android:visibility="gone"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>